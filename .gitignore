# Dependencies
node_modules/

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
log.txt

# IDE
.vscode/
.idea/
.history/

# Local config (may contain tokens)
.claude/
.deepvcode/

# Runtime data
data/

# Test artifacts
tests/utils/*.png
tests/utils/*.jpg
tests/utils/*.jpeg

# Environment
.env
.env.local

# Build output
dist/
build/

# Python bytecode — never commit compiled modules. Bytecode embeds string
# constants verbatim, so a stale .pyc can leak values that were later removed
# from source (and it churns diffs on every interpreter bump).
__pycache__/
*.py[cod]

# macOS resource forks
Icon
Icon?
*Icon\r

# Scratch workspace
scratch/
